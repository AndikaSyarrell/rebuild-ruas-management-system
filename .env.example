APP_PORT=8080
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=rms

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# WAJIB diisi dengan string acak & panjang (mis. `openssl rand -hex 32`) di production.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=rms-backend

CORS_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPTS_PER_IP_WINDOW=15m
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_LOCKOUT_DURATION=15m

PWCHANGE_MAX_ATTEMPTS=5
PWCHANGE_LOCKOUT_DURATION=15m

GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW=1m

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rms.local
SMTP_FROM_NAME=Ruas Management System
